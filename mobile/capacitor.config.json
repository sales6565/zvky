{
  "appId": "com.zvky.forge",
  "appName": "Zvky Forge",
  "webDir": "shell",
  "server": {
    "url": "https://zvkydesign.com",
    "cleartext": false,
    "errorPath": "offline.html",
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#12121aff",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
