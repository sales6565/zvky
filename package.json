{
  "name": "zvky-backend",
  "version": "1.0.0",
  "description": "Zvky Design Studio pipeline tracker — API and server",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "build": "echo 'No build step required — public/index.html is served as-is.'",
    "dev": "nodemon app.js",
    "test": "node --test \"tests/*.test.js\"",
    "roles:check": "node scripts/check-roles.js",
    "asset:check": "node scripts/check-asset.js",
    "tabs:check": "node scripts/check-tabs.js",
    "seed": "node src/seed/seed.js",
    "package": "bash scripts/build-godaddy-zip.sh",
    "sample:data": "node scripts/sample-data.js",
    "outbound:check": "node scripts/check-outbound.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.3",
    "pdfkit": "^0.20.2",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "docx": "^9.7.1",
    "nodemon": "^3.1.4",
    "pptxgenjs": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
