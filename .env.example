# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (MySQL / MariaDB) -------------------------------------------
# On cPanel these are the values from "MySQL Databases". The database and user
# names include your cPanel account prefix — copy them exactly as shown there.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Alternatively, a single connection URL instead of the five settings above:
# DATABASE_URL=mysql://user:password@localhost:3306/database

# --- Sessions --------------------------------------------------------------
# Long random string used to sign login sessions (JWTs). Changing it signs
# everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# --- Server ----------------------------------------------------------------
# Port the API listens on. On cPanel/Passenger this is set for you — leave it.
PORT=4000

# Comma-separated list of origins allowed to call the API. Since the frontend
# is served by this same app, set it to your own site URL.
# Use * only for local development.
CORS_ORIGIN=https://your-domain.com

# Number of reverse proxies in front of the app, so the real client address is
# read from X-Forwarded-For. 1 is correct for cPanel/Passenger.
TRUST_PROXY=1

# Sign-in attempts allowed per client address per window. A whole office shares
# one public IP, so this counts the whole studio — raise it for a large team.
LOGIN_RATE_MAX=100
LOGIN_RATE_WINDOW_MINUTES=15

# Password change attempts allowed per client address per window. Lower than
# sign-in: this endpoint takes the current password, so it is somewhere to
# guess one, and it is used occasionally by one person rather than in bursts.
PASSWORD_CHANGE_RATE_MAX=10
PASSWORD_CHANGE_RATE_WINDOW_MINUTES=15

# --- Accounts ----------------------------------------------------------------
# The password a NEW ACCOUNT is created with, and the one an administrator's
# "Reset password" sets an existing account back to. One value for both, so
# whoever hands it over has one thing to remember.
#
# SET THIS. The default below is in the public source, which means it is not a
# secret on any deployment that leaves it alone. An account is locked to a
# password change the moment this is set on it — it cannot be used to work — but
# it CAN be used to make that change, so anybody who knows the value and
# somebody's email address could take over a just-created or just-reset account
# before its owner signs in. Setting your own value here, and telling people
# promptly, are the two things that narrow that window.
#
# It deliberately does not have to meet the password rules the app enforces on a
# CHOSEN password: it is a credential with one use, and the rules are applied to
# whatever replaces it.
# DEFAULT_USER_PASSWORD=zvky2026

# --- Reference data ---------------------------------------------------------
# How often each worker reloads the asset type, priority and role lists from the
# database, in seconds. Reads already reload before answering, so this only
# covers a worker nobody is asking — it stops one that has not heard of a
# recently added role from refusing everyone who holds it. Set to 0 on a
# single-process deployment where nothing else writes to the database.
# REFERENCE_REFRESH_SECONDS=30

# --- Review pipeline --------------------------------------------------------
# Where a re-submission lands after the Creative Director asked for changes.
#   tl  the team lead who relayed the request re-checks it first (default)
#   cd  straight back to the Creative Director
# CD_CHANGES_REENTRY=tl

# --- Bulk asset import ------------------------------------------------------
# Bounds on a single import. A file past these is refused before any of it is
# processed, rather than being discovered part-way through.
IMPORT_MAX_ROWS=5000
# IMPORT_MAX_BYTES=20971520
# Rows per INSERT. Larger trades memory for fewer round trips.
# IMPORT_BATCH_SIZE=200

# --- IP allowlist ------------------------------------------------------------
# Restricts the whole application to specific addresses. The list itself lives
# in the database and is edited under Settings by a Super Admin; everything here
# is a way back in when that list is wrong, which is why it is in the
# environment rather than in the table it protects.
#
# READ THIS BEFORE YOU SWITCH IT ON. The address the app sees is not always the
# address you think you have, and getting it wrong locks everyone out, Super
# Admin included. Deploy once with IP_ALLOWLIST_MODE=monitor, open Settings ->
# Allowed IP Addresses, read the "You are connecting from" line, add that, and
# only then set it back to enforce.

# false turns the restriction off entirely. The kill switch if you are locked
# out and would rather not think about it.
# IP_ALLOWLIST_ENABLED=true

# monitor = block nothing, just log what would have been blocked.
# enforce = actually block.
#
# MONITOR IS THE DEFAULT and enforcing takes the exact word "enforce". Nothing
# else turns it on. The address this app sees for you is not always the address
# you think you have, and a list holding the wrong one locks everybody out of
# production the moment it starts blocking. Check the "You are connecting from"
# line on Settings -> Allowed IP Addresses first.
# IP_ALLOWLIST_MODE=enforce

# Requests arriving over loopback are never blocked. This host health-checks the
# app with a plain GET / from inside the container; refusing it makes the
# release unhealthy and it gets rolled back. A remote visitor cannot look like
# loopback — the address judged is the one your proxy wrote. Set to false only
# if this app is reachable directly rather than through a proxy.
# IP_ALLOWLIST_ALLOW_LOOPBACK=true

# Set true if your host health-checks from a container-network address
# (10.x, 172.16-31.x, 192.168.x) rather than over loopback.
# IP_ALLOWLIST_ALLOW_PRIVATE=false

# Addresses allowed regardless of what the database says, comma-separated.
# Single addresses or CIDR ranges. Set at least one: without it, a wrong entry
# means editing the database by hand to get back in. Every use is logged.
# IP_ALLOWLIST_EMERGENCY=203.0.113.4,192.0.2.0/24

# A shared secret that lets a request through from any address, sent as the
# X-Allowlist-Bypass header (or ?bypass=). Useful for a monitor or a support
# session. Treat it as a password — anyone holding it bypasses the restriction.
# IP_ALLOWLIST_BYPASS_TOKEN=

# If the allowlist tables cannot be read, the gate opens rather than closes, so
# a storage fault can never lock out the person who would fix it. Set this to
# true to refuse traffic instead. IGNORED unless an emergency address or bypass
# token is also set above — without one it would be an outage with no remedy.
# IP_ALLOWLIST_FAIL_CLOSED=false

# The address the list starts with, seeded only into an empty table. Set it to
# an empty string to seed nothing. Removing a seeded entry is permanent; it is
# not put back on the next restart.
# IP_ALLOWLIST_SEED=106.51.81.61

# HOW OFTEN EACH WORKER CATCHES UP with a change it did not make itself, in
# seconds. 0 switches it off.
#
# The gate reads the list from memory, because it runs ahead of everything on every
# request and cannot wait on a query. A write refreshes the copy held by the worker
# that handled it and no other — and Passenger (and most cPanel setups) run several
# workers against one database. Without this, a newly allowed office gets in only
# sometimes, depending on which worker answers, and an address whose access was
# REVOKED keeps working until a restart. The second is the restriction silently not
# applying, which nobody reports because from outside it looks fine.
#
# This also governs the integration's separate list. Two lists, two questions — but
# "how quickly must a change reach every worker" is one question for both.
# Only set it to 0 on a single-process deployment where nothing else writes.
# IP_ALLOWLIST_REFRESH_SECONDS=30

# NOTE: TRUST_PROXY above decides which address is judged. Too low and everyone
# looks like the proxy; too high and a client can name its own address. 1 is
# right behind cPanel/Passenger or a single load balancer.

# --- The integration API ----------------------------------------------------
# Another system in the studio calling Forge under /api/integration — a Dev & QA
# tool, a build server, a script. No person signs in here: a caller presents a
# machine credential, holds no designation, and is granted nothing on the Role
# Permissions screen. What each credential may do is written on the credential
# itself, in the integration_clients table.
#
# The credentials and the addresses live in the database; the secret and the
# switches live HERE, on the server, deliberately out of reach of anybody signed
# in to Forge. A door the application could open for itself is not a door.

# REQUIRED to use the integration API at all. The shared secret the caller signs
# its requests with: X-Integration-Signature: t=<unix seconds>, v1=<hex
# HMAC-SHA256 of "t.METHOD.path.rawBody">. A timestamp more than five minutes
# from the server clock is refused either way, so a captured request cannot be
# replayed later.
#
# Unset, every integration request answers 503 and does no work. That is
# deliberate: treating "no secret" as "no signature needed" would turn an
# unfinished setup into an open door, quietly, and only where it mattered.
#
# Use something long and random — `openssl rand -hex 32`. Keep it DIFFERENT from
# the secret Forge signs its own outbound calls with, so a leak in one direction
# is not a leak in both.
# INTEGRATION_INBOUND_SECRET=
# The secret being rotated out: requests signed with it are still accepted while it is
# set, so Dev & QA can switch to the new one without a gap. Remove it afterwards.
# INTEGRATION_INBOUND_SECRET_PREVIOUS=
# THE SWITCH. The Dev & QA integration API answers, and events are written and
# delivered, only while this is true. Secrets and keys alone do not switch it on.
# INTEGRATION_ENABLED=false

# The largest request body accepted on this path. The signature is taken over
# the exact bytes that arrived, so the body is read raw here before anything
# parses it — which is why it has its own limit.
# INTEGRATION_BODY_LIMIT=1mb

# The rate limit, per address, the same shape as the one on sign-in. An external
# caller retrying a failing job in a loop is the ordinary way this becomes a
# problem.
# INTEGRATION_RATE_WINDOW_MINUTES=1
# INTEGRATION_RATE_MAX=120

# ITS OWN ADDRESS LIST, in integration_ip_allowlist — separate from the sign-in
# allowlist above, and the sign-in gate does not govern this path at all. Two
# different questions: which offices may sign in, and which machines may call the
# API. Answering both from one list would mean whoever maintains the studio's
# offices silently decided whether a build server could reach Forge.
#
# It ships in MONITOR mode: it writes down what it would have refused and
# refuses nothing. Read the log, confirm the address the app actually sees for
# your caller, and only then set enforce. An empty list is treated as "not
# configured" and stays open, as is unreadable storage — the signature and the
# credential are the locks that hold either way.
# INTEGRATION_IP_ALLOWLIST_MODE=enforce
# INTEGRATION_IP_ALLOWLIST_ENABLED=true
# INTEGRATION_IP_ALLOWLIST_ALLOW_LOOPBACK=true
# INTEGRATION_IP_ALLOWLIST_ALLOW_PRIVATE=false
# INTEGRATION_IP_ALLOWLIST_EMERGENCY=203.0.113.4,192.0.2.0/24

# IDEMPOTENCY. Every POST, PUT and DELETE here must carry an Idempotency-Key
# header, and the same key with the same body replays the first response instead
# of doing the work twice. A caller that times out cannot know whether its
# request landed, so retrying is the only safe thing it can do — and recognising
# the retry is the only safe thing this end can do.
#
# Keys are remembered for seven days, then forgotten by a sweep that runs at
# startup and on a timer. A key sent again after the window is treated as new, so
# the window has to outlast any retry a caller will really make.
# INTEGRATION_IDEMPOTENCY_DAYS=7
# INTEGRATION_IDEMPOTENCY_SWEEP_MINUTES=60

# HOW LONG A CLAIM IS BELIEVED. The key is claimed before the work starts, so a
# duplicate arriving mid-flight is turned away rather than running alongside. If
# the process holding a claim is killed, nothing exists to finish or release it —
# so a claim older than this is treated as wreckage and the next retry takes the
# key over.
#
# Two minutes is two of the outbox's minimum one-minute retry intervals: the first
# retry after a crash is still told "in progress" and backs off, the second takes
# over. LOWER THIS WITH CARE — shorter than a caller's retry interval and a request
# that is merely slow has its key stolen by its own retry, which produces exactly
# the duplicate execution the claim exists to prevent. Raise it if a handler here
# can legitimately run longer than two minutes.
# INTEGRATION_IDEMPOTENCY_STALE_SECONDS=120

# The integration's own routes live under /api/integration/v1 — the version is part of
# the path because the capability a call needs is its first path segment after that
# mount, so the prefix cannot be a router inside /api/integration without every call
# asking for a capability called "v1".

# --- The outbox: what Forge sends OUT ------------------------------------------
# The other direction. When something happens here that Dev & QA needs to know
# about, the change and a row in integration_outbox are written in one
# transaction — so the fact and the intention to tell somebody commit together or
# neither does — and a worker delivers the row afterwards.
#
# Nothing about delivery can reach the request that caused it. A receiver that is
# down, slow, or silently accepting connections and never answering does not slow
# that request, fail it, or roll it back. Rows simply queue.

# Where to POST. Unset, nothing is delivered and rows accumulate — which is a
# state the startup log names rather than one you have to notice.
# Dev & QA's push receiver: https://<dev-qa address>/api/integrations/forge/events
# INTEGRATION_OUTBOUND_URL=https://devqa.example.com/api/integrations/forge/events

# THE SECRET FOR THIS DIRECTION, and it MUST NOT be the same value as
# INTEGRATION_INBOUND_SECRET above. One secret for both directions means whoever
# can verify a message can also forge one, which removes the only thing a
# signature proves. Forge refuses to deliver anything at all if the two match,
# rather than warning and carrying on — a setup that looks like it is working is
# worse than one that plainly is not.
#
# `openssl rand -hex 32`, and a different run of it from the inbound one.
# INTEGRATION_OUTBOUND_SECRET=

# The signature sent is the same shape the inbound side verifies:
# X-Integration-Signature: t=<unix seconds>, v1=<hex HMAC-SHA256 of
# "t.POST.path.rawBody">. Each attempt also carries X-Integration-Delivery (the
# row's id, the same on every retry of it) and X-Integration-Attempt, so the
# receiver can recognise a retry as one.

# The retry schedule is fixed in code and not configurable, because the other end
# has been told what to expect: 1 min, 5 min, 30 min, 2 h, 6 h, 24 h, and then the
# row is marked failed rather than retried forever. Seven attempts over a little
# over a day — enough to ride out an afternoon's outage without anybody
# intervening, and short enough that a week-long one is something somebody is told
# about instead of something quietly hammered.

# How often the worker looks, how many rows a pass, and how long one delivery may
# take. Ten seconds is the same deadline the push notifications hold Apple to.
# INTEGRATION_OUTBOX_SWEEP_SECONDS=60
# INTEGRATION_OUTBOX_BATCH=20
# INTEGRATION_OUTBOUND_TIMEOUT_MS=10000

# This deployment runs several Node workers against one database — Passenger and
# most cPanel setups do — so a row is CLAIMED before it is sent, or two workers
# would deliver the same webhook twice. A worker killed mid-delivery leaves a claim
# nothing will finish; a claim older than this is treated as wreckage and the row
# goes back in the queue. Comfortably longer than one delivery deadline.
# INTEGRATION_OUTBOX_CLAIM_SECONDS=120

# --- First-run only ---------------------------------------------------------
# Optional. POST /api/auth/bootstrap creates the first super admin when the
# database is empty — for hosts where you cannot run "npm run seed".
#
# You do not normally need to set this: when the database has no accounts, the
# app prints a one-time token to its startup log along with a ready-to-run
# command. Set a fixed value here only if you would rather not read the log.
#
# Either way the route 404s once any account exists. Unset this once you have
# signed in.
# BOOTSTRAP_TOKEN=

# --- Mobile apps ------------------------------------------------------------
# The native iOS and Android shells. All optional: with none of this set the
# apps still work — they are web views over this same application — they simply
# get no push notifications, and the Settings -> Mobile Apps screen says so.
# The full runbook, including where each of these values comes from, is in
# mobile/README.md.

# Apple push. From the Apple Developer portal: Keys -> "+" -> APNs. The .p8 can
# be downloaded exactly once; keep it in the studio's password manager.
# \n is accepted in place of real newlines, because .env handles them badly.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.zvky.forge
# APNS_KEY_P8=
# Defaults to api.push.apple.com, which is correct for an Ad Hoc build. Only a
# development build straight from Xcode talks to the sandbox.
# APNS_HOST=api.sandbox.push.apple.com

# Google push. From a Firebase service-account JSON: Project settings ->
# Service accounts -> Generate new private key. The Android build ALSO needs
# google-services.json at mobile/android/app/ — the server keys alone are not
# enough for a phone to obtain a token.
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# The public https origin the team reaches this application at, written exactly
# — no trailing slash, no internal hostname. REQUIRED once the iOS app is being
# handed out: the install manifest names the .ipa by absolute URL, and iOS
# fetches it from a system daemon, so an origin guessed from the request header
# produces an install that fails with a message naming nothing useful.
# MOBILE_DIST_BASE=https://your-domain.example

# The unguessable path segment the builds are served from. Generated on first
# use and written to dist-mobile/.dist-token, so it survives a restart. Set it
# here to rotate the install link after a leak, or to keep it identical across
# two servers behind a load balancer.
# MOBILE_DIST_TOKEN=

# Where the built .apk, .ipa and manifest.plist live. Defaults to dist-mobile/
# beside the application.
# MOBILE_DIST_DIR=
