node_modules/
# Settings and secrets come from the host's environment variables. A local .env (any
# variant) is for development only and is never committed; .env.example is the
# template, with placeholders only.
.env
.env.*
!.env.example
*.env
uploads/
*.log
dist/
*.zip

# The mobile builds and the token that serves them. Generated, large, and the
# token is a credential — none of it belongs in the repository.
dist-mobile/

# Created by "npx cap add". Generated from capacitor.config.json, large, and
# regenerated by "npx cap sync" — committing them would mean resolving merge
# conflicts in files nobody edits.
mobile/android/
mobile/ios/

# Signing keys. The Android keystore is irreplaceable (see mobile/README.md §4)
# and belongs in the studio's password manager, never here.
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
google-services.json
